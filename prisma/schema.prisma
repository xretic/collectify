generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model User {
    id                   Int                @id
    email                String             @unique
    passwordHash         String?
    avatarUrl            String             @default("")
    bannerUrl            String             @default("")
    username             String             @unique
    fullName             String
    description          String             @default("")
    githubId             String?            @unique
    googleId             String?            @unique
    createdAt            DateTime           @default(now())
    collections          Collection[]
    subscriptions        Follow[]           @relation("Subscriptions")
    followers            Follow[]           @relation("Followers")
    notifications        Notification[]     @relation("ReceivedNotifications")
    sentNotifications    Notification[]     @relation("SentNotifications")
    sessions             Session[]
    likes                Like[]
    favorites            Favorite[]
    comments             Comment[]
    chats                Chat[]
    messages             Message[]          @relation("SentMessages")
    receivedMessages     Message[]          @relation("ReceivedMessages")
    admin                Admin?
    verified             Verified?
    moderator            Moderator?
    sanctions            AccountSanction[]  @relation("UserSanctions")
    issuedSanctions      AccountSanction[]  @relation("IssuedSanctions")
    moderationActions    ModerationAction[] @relation("ModerationActionsActor")
    moderationTargets    ModerationAction[] @relation("ModerationActionsTargetUser")
    reportsMade          Report[]           @relation("ReportsMade")
    reportsReceived      Report[]           @relation("ReportsReceived")
    reportsReviewed      Report[]           @relation("ReportsReviewed")
    impersonatedSessions Session[]          @relation("ImpersonatedSessions")

    @@index([createdAt])
    @@index([username(ops: raw("gin_trgm_ops"))], map: "User_username_trgm_idx", type: Gin)
    @@index([fullName(ops: raw("gin_trgm_ops"))], map: "User_fullName_trgm_idx", type: Gin)
    @@index([email(ops: raw("gin_trgm_ops"))], map: "User_email_trgm_idx", type: Gin)
}

model Admin {
    id         Int      @id @default(autoincrement())
    userId     Int      @unique
    user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    assignedBy Int      @default(0)
    createdAt  DateTime @default(now())
}

model Verified {
    id        Int      @id @default(autoincrement())
    userId    Int      @unique
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())
}

model Moderator {
    id         Int      @id @default(autoincrement())
    userId     Int      @unique
    user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    assignedBy Int      @default(0)
    createdAt  DateTime @default(now())
}

model Chat {
    id            Int       @id @default(autoincrement())
    createdAt     DateTime  @default(now())
    lastMessageAt DateTime  @default(now())
    /// "<smallerUserId>:<biggerUserId>" — one direct chat per pair of users.
    pairKey       String?   @unique
    users         User[]
    messages      Message[]

    @@index([lastMessageAt])
}

model Message {
    id              Int      @id @default(autoincrement())
    chatId          Int
    userId          Int
    recipientUserId Int
    content         String
    read            Boolean  @default(false)
    createdAt       DateTime @default(now())

    chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
    user      User     @relation("SentMessages", fields: [userId], references: [id], onDelete: Cascade)
    recipient User     @relation("ReceivedMessages", fields: [recipientUserId], references: [id], onDelete: Cascade)
    reports   Report[]

    @@index([chatId, createdAt])
    @@index([userId, createdAt])
    @@index([recipientUserId, read])
}

model Notification {
    id              Int              @id @default(autoincrement())
    senderUserId    Int?
    recipientUserId Int
    createdAt       DateTime         @default(now())
    isRead          Boolean          @default(false)
    type            NotificationType
    collectionId    Int?
    collection      Collection?      @relation(fields: [collectionId], references: [id], onDelete: Cascade)
    recipientUser   User             @relation("ReceivedNotifications", fields: [recipientUserId], references: [id], onDelete: Cascade)
    senderUser      User?            @relation("SentNotifications", fields: [senderUserId], references: [id], onDelete: Cascade)

    @@index([recipientUserId, createdAt])
}

model AccountSanction {
    id          Int           @id @default(autoincrement())
    userId      Int
    moderatorId Int?
    scope       SanctionScope
    reason      String        @default("")
    expiresAt   DateTime?
    revokedAt   DateTime?
    createdAt   DateTime      @default(now())

    user      User     @relation("UserSanctions", fields: [userId], references: [id], onDelete: Cascade)
    moderator User?    @relation("IssuedSanctions", fields: [moderatorId], references: [id], onDelete: SetNull)
    reports   Report[]

    @@index([userId, scope])
    @@index([revokedAt, expiresAt])
}

model ModerationAction {
    id                 Int      @id @default(autoincrement())
    actorId            Int?
    impersonatorId     Int?
    targetUserId       Int?
    targetCollectionId Int?
    targetCommentId    Int?
    targetMessageId    Int?
    action             String
    reason             String   @default("")
    metadata           Json?
    createdAt          DateTime @default(now())

    actor            User?       @relation("ModerationActionsActor", fields: [actorId], references: [id], onDelete: SetNull)
    targetUser       User?       @relation("ModerationActionsTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
    targetCollection Collection? @relation(fields: [targetCollectionId], references: [id], onDelete: SetNull)
    targetComment    Comment?    @relation(fields: [targetCommentId], references: [id], onDelete: SetNull)

    @@index([actorId, createdAt])
    @@index([targetUserId, createdAt])
}

model Report {
    id              Int              @id @default(autoincrement())
    reporterId      Int
    targetUserId    Int
    targetType      ReportTargetType
    messageId       Int?
    commentId       Int?
    collectionId    Int?
    contentSnapshot Json?
    reason          ReportReason
    details         String           @default("")
    status          ReportStatus     @default(OPEN)
    /// Set only while the report is OPEN: "<reporterId>:<targetType>:<targetId>".
    /// The unique index prevents the same reporter from opening duplicate reports.
    openKey         String?          @unique
    verdict         ReportVerdict    @default(PENDING)
    duplicateOfId   Int?
    sanctionId      Int?
    reviewedById    Int?
    reviewedAt      DateTime?
    resolution      String           @default("")
    createdAt       DateTime         @default(now())

    reporter    User             @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
    targetUser  User             @relation("ReportsReceived", fields: [targetUserId], references: [id], onDelete: Cascade)
    reviewedBy  User?            @relation("ReportsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
    message     Message?         @relation(fields: [messageId], references: [id], onDelete: SetNull)
    comment     Comment?         @relation(fields: [commentId], references: [id], onDelete: SetNull)
    collection  Collection?      @relation(fields: [collectionId], references: [id], onDelete: SetNull)
    duplicateOf Report?          @relation("ReportDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
    duplicates  Report[]         @relation("ReportDuplicates")
    sanction    AccountSanction? @relation(fields: [sanctionId], references: [id], onDelete: SetNull)

    @@index([status, createdAt])
    @@index([targetUserId, createdAt])
    @@index([reporterId, createdAt])
    @@index([messageId])
    @@index([commentId])
    @@index([collectionId])
}

model Follow {
    followerId  Int
    followingId Int
    follower    User @relation("Subscriptions", fields: [followerId], references: [id], onDelete: Cascade)
    following   User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

    @@id([followerId, followingId])
    @@index([followingId])
}

model Session {
    id                 String   @id
    userId             Int
    impersonatorUserId Int?
    expiresAt          DateTime
    user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    impersonator       User?    @relation("ImpersonatedSessions", fields: [impersonatorUserId], references: [id], onDelete: SetNull)

    @@index([userId])
    @@index([impersonatorUserId])
    @@index([expiresAt])
}

model Collection {
    id                Int                @id @default(autoincrement())
    name              String
    lowerCaseName     String
    description       String             @default("")
    bannerUrl         String
    category          String
    userId            Int?
    createdAt         DateTime           @default(now())
    private           Boolean            @default(false)
    user              User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
    items             Item[]
    likes             Like[]
    favorites         Favorite[]
    comments          Comment[]
    notifications     Notification[]
    moderationActions ModerationAction[]
    reports           Report[]

    @@index([lowerCaseName])
    @@index([userId])
    @@index([private, category, createdAt])
}

model Comment {
    id                Int                @id @default(autoincrement())
    userId            Int
    collectionId      Int
    text              String
    createdAt         DateTime           @default(now())
    user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
    collection        Collection         @relation(fields: [collectionId], references: [id], onDelete: Cascade)
    moderationActions ModerationAction[]
    reports           Report[]

    @@index([collectionId, createdAt])
    @@index([userId, createdAt])
}

model Like {
    id           Int        @id @default(autoincrement())
    userId       Int
    collectionId Int
    createdAt    DateTime   @default(now())
    user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
    collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

    @@unique([userId, collectionId])
    @@index([collectionId])
}

model Favorite {
    userId       Int
    collectionId Int
    createdAt    DateTime   @default(now())
    user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
    collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

    @@id([userId, collectionId])
    @@index([collectionId, createdAt])
}

model Item {
    id           Int         @id @default(autoincrement())
    title        String
    description  String
    collectionId Int?
    sourceUrl    String?
    imageUrl     String?
    order        Int
    collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)

    @@index([collectionId, order])
}

enum NotificationType {
    FOLLOW
    LIKE
    COMMENT
    FAVORITE
    REPORT_RESOLVED
    SANCTION
}

enum SanctionScope {
    ACCOUNT
    COMMENTS
    MESSENGER
}

enum ReportStatus {
    OPEN
    CLOSED
}

enum ReportVerdict {
    PENDING
    NO_VIOLATION
    INSUFFICIENT_EVIDENCE
    DUPLICATE
    GUILTY
}

enum ReportReason {
    SPAM
    HARASSMENT
    HATE
    SCAM
    ADULT
    OTHER
}

enum ReportTargetType {
    USER
    MESSAGE
    COMMENT
    COLLECTION
}
