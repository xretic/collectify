generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model User {
    id                   Int                 @id
    email                String              @unique
    passwordHash         String?
    avatarUrl            String              @default("")
    bannerUrl            String              @default("")
    username             String              @unique
    fullName             String
    description          String              @default("")
    /// ISO 3166-1 alpha-2 code.
    country              String?
    city                 String?
    /// Lower-cased, whitespace-collapsed `city` used to match people nearby.
    cityKey              String?
    /// Private; users must be 18+ when it is set.
    birthDate            DateTime?           @db.Date
    /// Order of the home feed tabs: "for-you", "explore", "board:<id>".
    feedTabOrder         String[]            @default([])
    githubId             String?             @unique
    googleId             String?             @unique
    createdAt            DateTime            @default(now())
    collections          Collection[]
    subscriptions        Follow[]            @relation("Subscriptions")
    followers            Follow[]            @relation("Followers")
    notifications        Notification[]      @relation("ReceivedNotifications")
    sentNotifications    Notification[]      @relation("SentNotifications")
    sessions             Session[]
    likes                Like[]
    favorites            Favorite[]
    comments             Comment[]           @relation("CommentAuthor")
    commentReplyTargets  Comment[]           @relation("CommentReplyTargets")
    chats                Chat[]
    messages             Message[]           @relation("SentMessages")
    receivedMessages     Message[]           @relation("ReceivedMessages")
    admin                Admin?
    verified             Verified?
    moderator            Moderator?
    sanctions            AccountSanction[]   @relation("UserSanctions")
    issuedSanctions      AccountSanction[]   @relation("IssuedSanctions")
    moderationActions    ModerationAction[]  @relation("ModerationActionsActor")
    moderationTargets    ModerationAction[]  @relation("ModerationActionsTargetUser")
    reportsMade          Report[]            @relation("ReportsMade")
    reportsReceived      Report[]            @relation("ReportsReceived")
    reportsReviewed      Report[]            @relation("ReportsReviewed")
    impersonatedSessions Session[]           @relation("ImpersonatedSessions")
    createdTags          Tag[]
    boards               Board[]
    collectionViews      CollectionView[]
    engagedCollections   EngagedCollection[]
    interests            UserInterest[]
    chatMutes            ChatMute[]

    @@index([createdAt])
    @@index([country, cityKey])
    @@index([username(ops: raw("gin_trgm_ops"))], map: "User_username_trgm_idx", type: Gin)
    @@index([fullName(ops: raw("gin_trgm_ops"))], map: "User_fullName_trgm_idx", type: Gin)
    @@index([email(ops: raw("gin_trgm_ops"))], map: "User_email_trgm_idx", type: Gin)
}

model Admin {
    id         Int      @id @default(autoincrement())
    userId     Int      @unique
    user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    assignedBy Int      @default(0)
    createdAt  DateTime @default(now())
}

model Verified {
    id        Int      @id @default(autoincrement())
    userId    Int      @unique
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())
}

model Moderator {
    id         Int      @id @default(autoincrement())
    userId     Int      @unique
    user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    assignedBy Int      @default(0)
    createdAt  DateTime @default(now())
}

model Chat {
    id            Int        @id @default(autoincrement())
    createdAt     DateTime   @default(now())
    lastMessageAt DateTime   @default(now())
    /// "<smallerUserId>:<biggerUserId>" — one direct chat per pair of users.
    pairKey       String?    @unique
    users         User[]
    messages      Message[]
    mutes         ChatMute[]

    @@index([lastMessageAt])
}

/// A participant silenced message notifications of a chat.
model ChatMute {
    userId    Int
    chatId    Int
    /// `null` mutes until turned back on.
    until     DateTime?
    createdAt DateTime  @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

    @@id([userId, chatId])
    @@index([chatId])
}

model Message {
    id              Int       @id @default(autoincrement())
    chatId          Int
    userId          Int
    recipientUserId Int
    content         String
    read            Boolean   @default(false)
    /// When the recipient saw the message ("Seen" receipts).
    readAt          DateTime?
    createdAt       DateTime  @default(now())

    chat      Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
    user      User @relation("SentMessages", fields: [userId], references: [id], onDelete: Cascade)
    recipient User @relation("ReceivedMessages", fields: [recipientUserId], references: [id], onDelete: Cascade)

    @@index([chatId, createdAt])
    @@index([userId, createdAt])
    @@index([recipientUserId, read])
    @@index([chatId, userId, readAt])
}

model Notification {
    id              Int              @id @default(autoincrement())
    senderUserId    Int?
    recipientUserId Int
    createdAt       DateTime         @default(now())
    isRead          Boolean          @default(false)
    /// Set when the sender undid the action (unfollow, unlike...). The row is kept
    /// hidden so redoing the action restores it instead of notifying again.
    retractedAt     DateTime?
    type            NotificationType
    collectionId    Int?
    /// Comment the notification is about (new comment, reply, author's like).
    commentId       Int?
    collection      Collection?      @relation(fields: [collectionId], references: [id], onDelete: Cascade)
    comment         Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade)
    recipientUser   User             @relation("ReceivedNotifications", fields: [recipientUserId], references: [id], onDelete: Cascade)
    senderUser      User?            @relation("SentNotifications", fields: [senderUserId], references: [id], onDelete: Cascade)

    @@index([recipientUserId, createdAt])
    @@index([recipientUserId, isRead])
    /// Social notification dedupe (one per sender, recipient, type and target).
    @@index([recipientUserId, senderUserId, type])
    @@index([commentId])
}

model AccountSanction {
    id          Int           @id @default(autoincrement())
    userId      Int
    moderatorId Int?
    scope       SanctionScope
    reason      String        @default("")
    expiresAt   DateTime?
    revokedAt   DateTime?
    createdAt   DateTime      @default(now())

    user      User     @relation("UserSanctions", fields: [userId], references: [id], onDelete: Cascade)
    moderator User?    @relation("IssuedSanctions", fields: [moderatorId], references: [id], onDelete: SetNull)
    reports   Report[]

    @@index([userId, scope])
    @@index([revokedAt, expiresAt])
}

model ModerationAction {
    id                 Int      @id @default(autoincrement())
    actorId            Int?
    impersonatorId     Int?
    targetUserId       Int?
    targetCollectionId Int?
    targetCommentId    Int?
    action             String
    reason             String   @default("")
    metadata           Json?
    createdAt          DateTime @default(now())

    actor            User?       @relation("ModerationActionsActor", fields: [actorId], references: [id], onDelete: SetNull)
    targetUser       User?       @relation("ModerationActionsTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
    targetCollection Collection? @relation(fields: [targetCollectionId], references: [id], onDelete: SetNull)
    targetComment    Comment?    @relation(fields: [targetCommentId], references: [id], onDelete: SetNull)

    @@index([actorId, createdAt])
    @@index([targetUserId, createdAt])
}

model Report {
    id              Int              @id @default(autoincrement())
    reporterId      Int
    targetUserId    Int
    targetType      ReportTargetType
    commentId       Int?
    collectionId    Int?
    contentSnapshot Json?
    reason          ReportReason
    details         String           @default("")
    status          ReportStatus     @default(OPEN)
    /// Set only while the report is OPEN: "<reporterId>:<targetType>:<targetId>".
    /// The unique index prevents the same reporter from opening duplicate reports.
    openKey         String?          @unique
    verdict         ReportVerdict    @default(PENDING)
    duplicateOfId   Int?
    sanctionId      Int?
    reviewedById    Int?
    reviewedAt      DateTime?
    resolution      String           @default("")
    createdAt       DateTime         @default(now())

    reporter    User             @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
    targetUser  User             @relation("ReportsReceived", fields: [targetUserId], references: [id], onDelete: Cascade)
    reviewedBy  User?            @relation("ReportsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
    comment     Comment?         @relation(fields: [commentId], references: [id], onDelete: SetNull)
    collection  Collection?      @relation(fields: [collectionId], references: [id], onDelete: SetNull)
    duplicateOf Report?          @relation("ReportDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
    duplicates  Report[]         @relation("ReportDuplicates")
    sanction    AccountSanction? @relation(fields: [sanctionId], references: [id], onDelete: SetNull)

    @@index([status, createdAt])
    @@index([targetUserId, createdAt])
    @@index([reporterId, createdAt])
    @@index([commentId])
    @@index([collectionId])
}

model Follow {
    followerId  Int
    followingId Int
    follower    User @relation("Subscriptions", fields: [followerId], references: [id], onDelete: Cascade)
    following   User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

    /// The primary key serves "who X follows" (keyset by followingId); this
    /// index serves "who follows X" (keyset by followerId).
    @@id([followerId, followingId])
    @@index([followingId, followerId])
}

model Session {
    id                 String   @id
    userId             Int
    impersonatorUserId Int?
    expiresAt          DateTime
    user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    impersonator       User?    @relation("ImpersonatedSessions", fields: [impersonatorUserId], references: [id], onDelete: SetNull)

    @@index([userId])
    @@index([impersonatorUserId])
    @@index([expiresAt])
}

model Collection {
    id                Int                 @id @default(autoincrement())
    name              String
    lowerCaseName     String
    description       String              @default("")
    bannerUrl         String
    categoryId        Int
    category          Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
    userId            Int?
    createdAt         DateTime            @default(now())
    private           Boolean             @default(false)
    /// Number of "Like" rows, kept in sync by a DB trigger (see migration `scale_fixes`).
    likeCount         Int                 @default(0)
    user              User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
    items             Item[]
    likes             Like[]
    favorites         Favorite[]
    comments          Comment[]
    notifications     Notification[]
    moderationActions ModerationAction[]
    reports           Report[]
    tags              CollectionTag[]
    boards            BoardCollection[]
    views             CollectionView[]
    engagedBy         EngagedCollection[]

    @@index([lowerCaseName])
    @@index([userId])
    @@index([private, categoryId, createdAt])
    @@index([private, likeCount(sort: Desc)])
    @@index([private, categoryId, likeCount(sort: Desc)])
}

/// Managed by admins. Archived categories (`isActive = false`) keep their
/// collections but are hidden from pickers and filters.
model Category {
    id          Int            @id @default(autoincrement())
    slug        String         @unique
    name        String         @unique
    description String         @default("")
    position    Int            @default(0)
    isActive    Boolean        @default(true)
    createdAt   DateTime       @default(now())
    collections Collection[]
    tags        Tag[]
    interested  UserInterest[]

    @@index([isActive, position])
}

/// User-created, global within its category. `usageCount` (maintained by a
/// trigger on "CollectionTag") is the popularity used to rank suggestions.
model Tag {
    id          Int             @id @default(autoincrement())
    name        String
    /// Lower-cased, whitespace-collapsed `name`; unique per category.
    normalized  String
    categoryId  Int
    usageCount  Int             @default(0)
    createdById Int?
    createdAt   DateTime        @default(now())
    category    Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
    collections CollectionTag[]

    @@unique([categoryId, normalized])
    @@index([categoryId, usageCount(sort: Desc)])
    @@index([createdById, createdAt])
    @@index([normalized(ops: raw("gin_trgm_ops"))], map: "Tag_normalized_trgm_idx", type: Gin)
}

/// A user's own grouping of saved collections (Pinterest-like board).
/// Every collection on a board is also in the user's favorites ("All").
model Board {
    id          Int               @id @default(autoincrement())
    userId      Int
    name        String
    createdAt   DateTime          @default(now())
    updatedAt   DateTime          @default(now()) @updatedAt
    user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
    collections BoardCollection[]

    @@unique([userId, name])
    @@index([userId, createdAt])
}

model BoardCollection {
    boardId      Int
    collectionId Int
    createdAt    DateTime   @default(now())
    board        Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)
    collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

    @@id([boardId, collectionId])
    @@index([collectionId])
    @@index([boardId, createdAt])
}

/// Signed-in views, a recommendation signal (counted at most once per 10 minutes).
model CollectionView {
    userId       Int
    collectionId Int
    count        Int        @default(1)
    lastViewedAt DateTime   @default(now())
    user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
    collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

    @@id([userId, collectionId])
    @@index([collectionId])
}

/// Collections the user has ever liked or favorited. Kept after unliking, so
/// they are never recommended again.
model EngagedCollection {
    userId       Int
    collectionId Int
    createdAt    DateTime   @default(now())
    user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
    collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

    @@id([userId, collectionId])
    @@index([collectionId])
}

/// Categories picked at sign-up; seeds recommendations before there is activity.
model UserInterest {
    userId     Int
    categoryId Int
    createdAt  DateTime @default(now())
    user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

    @@id([userId, categoryId])
}

model CollectionTag {
    collectionId Int
    tagId        Int
    createdAt    DateTime   @default(now())
    collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
    tag          Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

    @@id([collectionId, tagId])
    @@index([tagId, collectionId])
}

model Comment {
    id                Int                @id @default(autoincrement())
    userId            Int
    collectionId      Int
    /// Root comment of the thread; replies are one level deep.
    parentId          Int?
    /// Who a reply answers (shown as @username), may differ from the root's author.
    replyToUserId     Int?
    text              String
    createdAt         DateTime           @default(now())
    editedAt          DateTime?
    /// Heart from the collection owner ("liked by the author").
    likedByAuthor     Boolean            @default(false)
    user              User               @relation("CommentAuthor", fields: [userId], references: [id], onDelete: Cascade)
    replyToUser       User?              @relation("CommentReplyTargets", fields: [replyToUserId], references: [id], onDelete: SetNull)
    collection        Collection         @relation(fields: [collectionId], references: [id], onDelete: Cascade)
    parent            Comment?           @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
    replies           Comment[]          @relation("CommentReplies")
    moderationActions ModerationAction[]
    reports           Report[]
    notifications     Notification[]

    @@index([collectionId, parentId, id])
    @@index([parentId, id])
    @@index([collectionId, createdAt])
    @@index([userId, createdAt])
}

model Like {
    id           Int        @id @default(autoincrement())
    userId       Int
    collectionId Int
    createdAt    DateTime   @default(now())
    user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
    collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

    @@unique([userId, collectionId])
    @@index([collectionId])
}

model Favorite {
    userId       Int
    collectionId Int
    createdAt    DateTime   @default(now())
    user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
    collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

    @@id([userId, collectionId])
    @@index([collectionId, createdAt])
}

model Item {
    id           Int         @id @default(autoincrement())
    /// Optional when the item has an image.
    title        String      @default("")
    description  String      @default("")
    collectionId Int?
    sourceUrl    String?
    imageUrl     String?
    size         ItemSize    @default(M)
    order        Int
    collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)

    @@index([collectionId, order])
}

/// Footprint of an item card in the collection's masonry grid.
enum ItemSize {
    S
    M
    L
    XL
}

enum NotificationType {
    FOLLOW
    LIKE
    COMMENT
    FAVORITE
    REPORT_RESOLVED
    SANCTION
    COMMENT_REPLY
    COMMENT_LIKED
}

enum SanctionScope {
    ACCOUNT
    COMMENTS
    MESSENGER
}

enum ReportStatus {
    OPEN
    CLOSED
}

enum ReportVerdict {
    PENDING
    NO_VIOLATION
    INSUFFICIENT_EVIDENCE
    DUPLICATE
    GUILTY
}

enum ReportReason {
    SPAM
    HARASSMENT
    HATE
    SCAM
    ADULT
    OTHER
}

enum ReportTargetType {
    USER
    COMMENT
    COLLECTION
}
