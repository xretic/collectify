# --- Required -----------------------------------------------------------------
# Neon (production) or any Postgres (local). The adapter is picked from the host.
DATABASE_URL=""

# Public origin, e.g. https://collectify.app (OAuth redirect URIs, WebSocket origin check).
# Falls back to the request origin when empty.
APP_URL=""

# --- OAuth (optional) ------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Realtime: Pusher on Vercel; without it the custom server uses Socket.IO -------
PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# --- Uploads ------------------------------------------------------------------------
NEXT_PUBLIC_UPLOADCARE_PUBLIC_KEY=""

# --- Redis (optional): search cache + rate limits. Upstash wins if both are set -------
REDIS_URL=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Tests ------------------------------------------------------------------------
# Disposable database for integration tests (it is TRUNCATEd!). Leave empty to skip them.
TEST_DATABASE_URL=""
