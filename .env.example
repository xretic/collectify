# --- Required -----------------------------------------------------------------
# Neon pooled connection URL.
DATABASE_URL=""
# Direct (non-pooler) Neon URL for `prisma migrate`
DIRECT_URL=""

# Public origin, e.g. https://colleo.xyz (OAuth redirect URIs, WebSocket origin check).
# Falls back to the request origin when empty.
APP_URL=""

# Self-hosting (`npm start`) behind your own reverse proxy: "true" trusts the X-Real-IP /
# X-Forwarded-For it sets. Leave empty when clients connect directly (they could forge them).
TRUST_PROXY=""

# --- OAuth (optional) ------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Realtime: Pusher on Vercel; without it the custom server uses Socket.IO -------
PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# --- Uploads ------------------------------------------------------------------------
NEXT_PUBLIC_UPLOADCARE_PUBLIC_KEY=""

# --- Email (password reset, email confirmation) ---------------------------------------
# Without a key, or while the sender domain is unverified, sending answers 503
# "email is not available". Production also needs APP_URL.
RESEND_API_KEY=""
# Sender on a domain verified at resend.com/domains, e.g. "Collectify <noreply@colleo.xyz>".
# onboarding@resend.dev (Resend's test sender) only delivers to the Resend account owner.
EMAIL_FROM="Collectify <noreply@colleo.xyz>"

# --- Legal pages: who runs the service (Legal notice, Terms, Privacy Policy) ---------------
LEGAL_NAME=""
LEGAL_ADDRESS=""
CONTACT_EMAIL=""
# Country whose law governs the Terms, e.g. "Czech Republic".
LEGAL_COUNTRY=""

# --- Uploadcare REST key (optional): deleting an account also deletes its uploaded images ---
UPLOADCARE_SECRET_KEY=""

# --- Search engines (optional): ownership tokens from Google Search Console, Bing, Yandex ---
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
YANDEX_VERIFICATION=""

# --- Redis (optional): search cache + rate limits. Upstash wins if both are set -------
REDIS_URL=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
